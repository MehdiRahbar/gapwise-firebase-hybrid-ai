# These are public Firebase WEB APP configuration values, not secrets.
# Copy to .env.local. Never commit private App Check debug tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Public reCAPTCHA Enterprise (Fraud Defense) / v3 site key registered with Firebase App Check
VITE_APPCHECK_SITE_KEY=
# Provider type: 'enterprise' (default for Fraud Defense / reCAPTCHA Enterprise) or 'v3'
VITE_APPCHECK_PROVIDER=enterprise
# Development ONLY: set true to request a debug token locally; register in Firebase Console
# DO NOT enable for published builds or store generated token in files.
VITE_APPCHECK_DEBUG=false
